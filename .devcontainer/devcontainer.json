{
  // GitHub Codespaces / VS Code Dev Containers configuration (#1671).
  // See docs/codespaces.md for the full workflow.
  "name": "QuorumProof",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-22.04",

  "features": {
    "ghcr.io/devcontainers/features/rust:1": {
      "version": "stable",
      "profile": "default",
      "targets": "wasm32-unknown-unknown"
    },
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20"
    },
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.11"
    },
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },

  // Forwarded ports: API server (3000), frontend (5173), dashboard (Vite default 5173 is
  // taken by the frontend, so the dashboard falls back to 5174 when both run).
  "forwardPorts": [3000, 5173, 5174],
  "portsAttributes": {
    "3000": { "label": "API server", "onAutoForward": "notify" },
    "5173": { "label": "Frontend", "onAutoForward": "openPreview" },
    "5174": { "label": "Dashboard", "onAutoForward": "silent" }
  },

  "postCreateCommand": "bash .devcontainer/post-create.sh",

  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "esbenp.prettier-vscode",
        "dbaeumer.vscode-eslint",
        "tamasfe.even-better-toml",
        "redhat.vscode-yaml"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.tabSize": 4
      }
    }
  },

  "remoteUser": "vscode"
}
