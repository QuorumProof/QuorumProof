{
  "QuorumProof: Soroban Contract Boilerplate": {
    "scope": "rust",
    "prefix": "qp-contract",
    "description": "Scaffold a new Soroban smart contract with contractimpl and standard imports",
    "body": [
      "#![no_std]",
      "use soroban_sdk::{contract, contractimpl, contracttype, symbol_short, Address, Env, String, Symbol, Vec};",
      "",
      "#[contract]",
      "pub struct ${1:ContractName};",
      "",
      "#[contractimpl]",
      "impl ${1:ContractName} {",
      "    /// Initializes the contract with an admin address.",
      "    pub fn initialize(env: Env, admin: Address) {",
      "        admin.require_auth();",
      "        if env.storage().instance().has(&DataKey::Admin) {",
      "            panic!(\"Already initialized\");",
      "        }",
      "        env.storage().instance().set(&DataKey::Admin, &admin);",
      "    }",
      "",
      "    /// ${2:Contract function description}",
      "    pub fn ${3:execute}(env: Env, caller: Address) -> Result<bool, ${4:ContractError}> {",
      "        caller.require_auth();",
      "        ${0:// Implementation}",
      "        Ok(true)",
      "    }",
      "}",
      "",
      "#[contracttype]",
      "#[derive(Clone)]",
      "pub enum DataKey {",
      "    Admin,",
      "    ${5:State}(Address),",
      "}"
    ]
  },

  "QuorumProof: Contract Error Enum": {
    "scope": "rust",
    "prefix": "qp-error-enum",
    "description": "Create a Soroban #[contracterror] enum with descriptive error codes",
    "body": [
      "use soroban_sdk::contracterror;",
      "",
      "#[contracterror]",
      "#[derive(Copy, Clone, Debug, Eq, PartialEq, PartialOrd, Ord)]",
      "#[repr(u32)]",
      "pub enum ${1:ContractError} {",
      "    NotInitialized = 1,",
      "    AlreadyInitialized = 2,",
      "    Unauthorized = 3,",
      "    InvalidThreshold = 4,",
      "    ProofVerificationFailed = 5,",
      "    CredentialExpired = 6,",
      "    ${0:CustomError = 100,}",
      "}"
    ]
  },

