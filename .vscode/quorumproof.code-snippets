  "QuorumProof: TS WebSocket Event Subscription": {
    "scope": "typescript,javascript",
    "prefix": "qp-ws-subscribe",
    "description": "Subscribe to real-time QuorumProof events via WebSocket with reconnect",
    "body": [
      "export function subscribeToEvents(url: string, onEvent: (data: any) => void) {",
      "    const ws = new WebSocket(url);",
      "",
      "    ws.onopen = () => {",
      "        console.log(\"Connected to QuorumProof event feed\");",
      "        ws.send(JSON.stringify({ action: \"subscribe\", topic: \"credentials\" }));",
      "    };",
      "",
      "    ws.onmessage = (event) => {",
      "        const payload = JSON.parse(event.data);",
      "        onEvent(payload);",
      "    };",
      "",
      "    ws.onerror = (error) => console.error(\"WebSocket error:\", error);",
      "    ws.onclose = () => {",
      "        console.log(\"Reconnecting in 3s...\");",
      "        setTimeout(() => subscribeToEvents(url, onEvent), 3000);",
      "    };",
      "",
      "    return () => ws.close();",
      "}"
    ]
  }
