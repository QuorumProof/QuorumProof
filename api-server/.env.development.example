# Issue #1676 — development configuration for the API server.
#
# Copy to api-server/.env.development and load it into your shell before
# starting the watch loop:
#
#   cp api-server/.env.development.example api-server/.env.development
#   set -a; source api-server/.env.development; set +a
#   cd api-server && npm run dev
#
# The API server does not read .env files itself; values must be exported.
# Never commit a filled-in copy. Only this .example file belongs in git.

NODE_ENV=development

# Local API port (read by src/index.ts).
PORT=3001

# Stellar testnet. Contract IDs are set after `scripts/deploy_testnet.sh`
# or a local deploy; leave blank to run without on-chain reads.
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
CONTRACT_QUORUM_PROOF=
CONTRACT_SBT_REGISTRY=
CONTRACT_ZK_VERIFIER=

# Relaxed, local-only values. Never reuse these outside development.
PUBLIC_APP_BASE_URL=http://localhost:3000
SHARE_LINK_HMAC_SECRET=dev-only-share-link-secret
HMAC_SIGNING_SECRET=dev-only-hmac-secret
BRIDGE_HMAC_SECRET=dev-only-bridge-secret
TRUSTED_IPS=127.0.0.1

# Verbose request logging for debugging during development.
LOG_LEVEL=debug
