{
  "name": "quorumproof-api-server",
  "version": "1.0.0",
  "description": "REST API server for QuorumProof Soroban contracts",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc --noEmit false 2>&1 || true",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest --run",
    "loadtest:ws": "tsx loadtest/wsLoadTest.ts"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^14.6.1",
    "ajv": "^8.20.0",
    "compression": "^1.8.1",
    "express": "^4.21.2",
    "ioredis": "^5.11.1",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.3",
    "@types/node": "^24.12.0",
    "@types/supertest": "^7.2.0",
    "@types/ws": "^8.18.1",
    "supertest": "^7.2.2",
    "tsx": "^4.19.4",
    "typescript": "~5.9.3",
    "vitest": "^1.6.0"
  }
}
