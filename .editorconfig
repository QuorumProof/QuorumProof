# EditorConfig (Issue #1679): shared whitespace rules across every language
# in the repo. Matches the defaults in .vscode/settings.json.
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.rs]
indent_size = 4

[*.py]
indent_size = 4

[*.{sh,toml}]
indent_size = 4

[*.md]
# Markdown uses trailing double-spaces for hard line breaks in some docs.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
